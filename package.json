{
  "name": "asuka-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "displayName": "Asuka Agent",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev:web": "npm run dev --workspace @asuka-agent/web --",
    "dev:gateway": "npm run dev --workspace @asuka-agent/napcat-gateway",
    "dev:control-api": "npm run dev --workspace @asuka-agent/control-api",
    "dev:worker": "npm run dev --workspace @asuka-agent/agent-worker",
    "worker": "npm run once --workspace @asuka-agent/agent-worker",
    "build": "bash scripts/build-verified.sh",
    "start": "npm run start --workspace @asuka-agent/web",
    "lint": "bash scripts/sites-env.sh -- eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:boundaries": "node scripts/check-workspace-boundaries.mjs",
    "test:unit": "npm run test --workspace @asuka-agent/agent-core && npm run test --workspace @asuka-agent/im && npm run test --workspace @asuka-agent/llm && npm run test --workspace @asuka-agent/control-api",
    "test:web": "npm run test --workspace @asuka-agent/web",
    "test": "npm run build && npm run test:unit && npm run test:web",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "db:generate": "npm run db:generate --workspace @asuka-agent/db",
    "db:check": "npm run db:check --workspace @asuka-agent/db",
    "db:migrate": "npm run db:migrate --workspace @asuka-agent/db"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "typescript": "5.9.3"
  }
}
