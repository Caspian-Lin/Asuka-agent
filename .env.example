# Ask the PostgreSQL administrator to create this role and database, then replace CHANGE_ME.
DATABASE_URL=postgresql://asuka_agent:CHANGE_ME@127.0.0.1:5432/asuka_agent
DATABASE_SSL=false
# Optional: only db:reset reads this local PostgreSQL superuser connection when the app role lacks CREATEDB.
# DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres
# 32 random bytes encoded as Base64, for example: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=CHANGE_ME

# NapCat OneBot 11 positive WebSocket server. Keep it on loopback unless TLS/auth is configured.
NAPCAT_WS_URL=ws://127.0.0.1:3001/
NAPCAT_ACCESS_TOKEN=
NAPCAT_ACCOUNT_ID=
# Comma-separated QQ group IDs. Empty means no group message is retained.
NAPCAT_GROUP_WHITELIST=
# Comma-separated QQ user IDs allowed to create private conversations.
NAPCAT_PRIVATE_USER_WHITELIST=
# Durable outbound queue polling and OneBot action response deadline.
NAPCAT_OUTBOUND_POLL_MS=500
NAPCAT_OUTBOUND_RESPONSE_TIMEOUT_MS=30000

# Local PostgreSQL control API and inbound projection worker.
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=3002
NEXT_PUBLIC_CONTROL_API_URL=http://127.0.0.1:3002
AGENT_INBOUND_BATCH_SIZE=20
AGENT_INBOUND_POLL_MS=5000
AGENT_COGNITION_POLL_MS=10000
AGENT_COGNITION_LEASE_MS=90000
