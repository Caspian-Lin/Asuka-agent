{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://purr.local/schemas/phase1-evaluation.schema.json",
  "title": "Phase 1 Memory Evaluation Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["suite", "version", "cases"],
  "properties": {
    "suite": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "prompt", "expected", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
        "category": {
          "enum": [
            "single_fact_recall",
            "goal_recall",
            "multi_session_reasoning",
            "temporal_reasoning",
            "knowledge_update",
            "abstention"
          ]
        },
        "prompt": { "type": "string", "minLength": 2 },
        "expected": {
          "oneOf": [
            { "$ref": "#/$defs/recallExpectation" },
            { "$ref": "#/$defs/abstentionExpectation" }
          ]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "recallExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedMemoryId"],
      "properties": {
        "expectedMemoryId": { "type": "string", "minLength": 1 },
        "topK": { "type": "integer", "minimum": 1, "maximum": 20, "default": 3 }
      }
    },
    "abstentionExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["abstain"],
      "properties": {
        "abstain": { "const": true },
        "maxTopScore": { "type": "number", "minimum": 0, "default": 1.25 }
      }
    }
  }
}
